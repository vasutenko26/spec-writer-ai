# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SearXNG (Local search aggregator)
SEARXNG_URL=http://127.0.0.1:8888

# Server port
PORT=3001

# Google PageSpeed Insights API (optional)
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# JWT Authentication
JWT_SECRET=generate_random_secret_here
JWT_EXPIRES_IN=7d

# Google Search Console OAuth (optional)
GSC_CLIENT_ID=your_gsc_client_id_here
GSC_CLIENT_SECRET=your_gsc_client_secret_here
GSC_REDIRECT_URI=https://yourdomain.com/api/gsc/callback

# DataForSEO API (optional - replaced by SearXNG)
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password
DATAFORSEO_BASE64=base64_encoded_credentials

# SEOranking API (optional)
SERANKING_API_KEY=your_seranking_api_key
